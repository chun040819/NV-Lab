HOST_PORT=8088
PUBLIC_BASE_URL=http://DGX_IP:8088
OLLAMA_MODEL=gemma3:4b
MAX_UPLOAD_MB=50
MAX_VIDEO_SECONDS=20
MAX_AUDIO_SECONDS=30
VLM_ENABLED=true
# Stage 2: change to true only after building and starting the corresponding profile.
VISION_ENABLED=false
AUDIO_ENABLED=false
VISION_MODEL=ms_eff_gcvit_b0
VISION_DATASET=celeb_df_v2
VISION_THRESHOLD=0.80
DETECTOR_TIMEOUT_SECONDS=240
# Conservative NVIDIA DGX Spark base image; check host driver compatibility.
PYTORCH_BASE=nvcr.io/nvidia/pytorch:25.11-py3

# Stage 3: only enable after STALL has been warmed up with authorized DINOv3 weights.
SYNTHETIC_ENABLED=false
STALL_MAX_WINDOWS=3
STALL_FRAME_BATCH=4
STALL_WARNING_THRESHOLD=0.75
SYNTHETIC_TIMEOUT_SECONDS=480
